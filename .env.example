# ==============================================================================
# Synergy B2B Wholesale Portal — Enterprise Environment Specification
# ==============================================================================
# Copy this file to .env.local (development) or configure via Vercel Project Settings.
# NEVER commit actual production secrets or private keys to version control.

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage & Realtime)
# ------------------------------------------------------------------------------
# Client-side (Publicly accessible in browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side (Vercel Serverless Functions Only — NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 2. 1C:ERP Integration Gateway
# ------------------------------------------------------------------------------
# Primary endpoint of the ERP proxy/gateway
ERP_API_URL=https://kilem-khan.kz/api/sin/public/api_portal.php
ERP_API_KEY=your_erp_master_api_key_sha256

# Inbound Webhook signature verification secret (HMAC SHA-256)
ERP_WEBHOOK_SECRET=your_erp_webhook_shared_secret
PORTAL_SECRET_KEY=your_portal_shared_secret_key

# ------------------------------------------------------------------------------
# 3. Emergency Alerting & Incident Response (DLQ)
# ------------------------------------------------------------------------------
# Telegram Bot Webhook / SendMessage URL for critical dead-letter queue alerts
TELEGRAM_ALERT_WEBHOOK_URL=https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>

# WhatsApp Notification recipient phone for high-priority alerts (E.164 format)
ADMIN_WHATSAPP_PHONE=+77000000000
WHATSAPP_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# ------------------------------------------------------------------------------
# 4. Security & CORS Origin Whitelist
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for B2B portal API calls
ALLOWED_ORIGINS=https://b2b.synergy.kz,https://synergy-b2b-portal.vercel.app,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Scheduled Tasks & Automation (Crons)
# ------------------------------------------------------------------------------
# Secret token required to invoke /api/cron/* endpoints
CRON_SECRET=your_high_entropy_cron_bearer_token

# WMS reservation hold expiration window in hours (default: 24)
WMS_HOLD_TTL_HOURS=24

# ------------------------------------------------------------------------------
# 6. Distributed Redis (Upstash / Vercel KV for Circuit Breaker, Rate Limit & Blacklist)
# ------------------------------------------------------------------------------
# Required in production to prevent split-brain state across serverless instances
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

