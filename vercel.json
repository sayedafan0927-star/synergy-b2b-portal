{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/reconcile-balances",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/expire-holds",
      "schedule": "0 4 * * *"
    }
  ],
  "crons_reference": {
    "outbox_sync": "/api/outbox/sync"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
