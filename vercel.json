{
  "version": 2,
  "crons": [
    {
      "path": "/api/outbox/sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/expire-holds",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
